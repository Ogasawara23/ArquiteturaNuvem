{
  "name": "bff-kds",
  "version": "1.0.0",
  "private": true,
  "description": "SmartKDS & Menu - Backend for Frontend da tela de producao (KDS): tickets por estacao, SLA calculado no servidor e stream SSE",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "amqplib": "^0.10.5",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
