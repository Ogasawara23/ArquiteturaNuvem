{
  "name": "shell-operacao",
  "version": "1.0.0",
  "private": true,
  "description": "SmartKDS & Menu - shell host (Module Federation) da operacao: login OIDC/PKCE, sessao e carga dos remotes mfe-kds, mfe-cardapio e mfe-gestao",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5200 --strictPort",
